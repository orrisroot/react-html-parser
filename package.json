{
  "name": "@orrisroot/react-html-parser",
  "version": "3.0.1",
  "description": "Parse HTML into React components",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "umd:main": "dist/react-html-parser.min.js",
  "unpkg": "dist/react-html-parser.min.js",
  "jsdelivr": "dist/react-html-parser.min.js",
  "source": "src/index.ts",
  "scripts": {
    "clean": "rimraf coverage dist",
    "check": "npm run lint && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "build": "npm run build:lib && npm run build:umd:min && npm run build:umd",
    "build:lib": "tsdown",
    "build:umd": "vite build --config vite.dev.ts",
    "build:umd:min": "vite build --config vite.prod.ts",
    "prerelease": "npm run clean && npm run check",
    "release": "npm run build",
    "postrelease": "git push --follow-tags && npm publish",
    "release:patch": "npm version patch && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:major": "npm version major && npm run release",
    "demo:clean": "rimraf demo/dist",
    "demo:dev": "cd demo && npm run dev",
    "demo:build": "cd demo && npm run build",
    "demo:publish": "npm run demo:clean && npm run demo:build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/orrisroot/react-html-parser.git"
  },
  "keywords": [
    "react",
    "html",
    "htmlparser",
    "htmlparser2",
    "inner html",
    "dangerouslySetInnerHTML"
  ],
  "author": "Peter Newnham",
  "contributors": [
    "Yoshihiro Okumura"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "^6.1.3",
    "terser": "^5.48.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
